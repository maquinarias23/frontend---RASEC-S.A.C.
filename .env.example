# URL del backend. VACIA = el frontend la deduce del host por el que se abre la
# app: localhost en la PC servidor, 192.168.x.x desde la red local. Definirla
# solo para apuntar a un servidor/dominio fijo (ej. https://api.midominio.com/api).
VITE_API_URL=
# Puerto del backend usado cuando VITE_API_URL esta vacia
VITE_API_PORT=4000
# Numero de WhatsApp de la empresa (formato internacional, sin +) para la landing y el catalogo publico
VITE_WHATSAPP_NUMBER=
# Codigo de pais que se antepone al telefono del cliente en los enlaces wa.me. Peru = 51
VITE_WHATSAPP_CODIGO_PAIS=51
